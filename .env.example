# ── Microsoft (SharePoint + Teams) ──────────────────────────────────────────
# Create an App Registration in Azure AD:
#   https://portal.azure.com → Azure Active Directory → App registrations
#   Grant: Sites.Read.All, ChannelMessage.Read.All, Files.Read.All
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# SharePoint site URL (e.g. https://contoso.sharepoint.com/sites/ProjectFalcon)
SHAREPOINT_SITE_URL=https://your-tenant.sharepoint.com/sites/YourSite

# Teams channel to pull messages from (display name)
TEAMS_CHANNEL_NAME=Project Falcon

# ── ServiceNow ───────────────────────────────────────────────────────────────
# Free PDI: https://developer.servicenow.com → Start Building → Request Instance
SERVICENOW_INSTANCE=https://your-instance.service-now.com
SERVICENOW_USER=admin
SERVICENOW_PASS=your-password

# ── Local AI (Ollama) ────────────────────────────────────────────────────────
# Install: https://ollama.com  →  ollama pull llama3.1
# Runs entirely on your machine — zero token costs
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Demo mode ────────────────────────────────────────────────────────────────
# Set to "true" to use built-in mock data (no credentials needed)
DEMO_MODE=true
